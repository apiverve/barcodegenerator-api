        "apiverve",
        "barcodegenerator",
        "barcode api",
        "barcode generator api",
        "barcode generation api",
        "generate barcode api",
        "barcode image api"
    ],
    "homepage": "https://apiverve.com/marketplace/barcodegenerator?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
